---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getCountry, type CountryConfig } from "../lib/countries";

export const prerender = true;

interface Props {
  country?: CountryConfig;
}

const { country = getCountry("IN") } = Astro.props;

function faqsFor(country: CountryConfig) {
  const symbol = country.currency.symbol;
  const shared = [
    {
      q: "How accurate is the vehicle mileage figure?",
      a:
        country.code === "IN"
          ? "Vehicle presets use ARAI-claimed (test-cycle) mileage, which is normally higher than what you'll see in real city traffic. Always feel free to overwrite it with your own observed mileage for a more accurate result."
          : "Vehicle presets are representative figures, not a lab-verified guarantee — real-world mileage varies with driving style, load, and traffic. Always feel free to overwrite it with your own observed mileage for a more accurate result.",
    },
    {
      q: "How is the EV running cost calculated?",
      a: `We use your electricity tariff (${symbol}/kWh) and the vehicle's efficiency (kWh per 100${country.distanceUnit}) — cost per ${country.distanceUnit} = (tariff × efficiency) ÷ 100. The default tariff is fully editable to match your actual rate.`,
    },
    {
      q: "Can I share my calculation with someone else?",
      a: "Yes — every input you change updates the page URL, so you can copy and share the link at any point and the other person will see the exact same setup.",
    },
  ];

  if (country.code === "IN") {
    return [
      {
        q: "Where do the city fuel prices come from?",
        a: "Prices are refreshed automatically several times a day from public sources. They're indicative — local taxes, dealer commission, and daily revisions mean the pump price can differ slightly. You can always type in your own price instead.",
      },
      {
        q: "Why doesn't every city have CNG or LPG prices?",
        a: "CNG and Auto LPG distribution networks are patchy across India — not every city has retail infrastructure for them yet, so we only show a price where it's realistically available.",
      },
      {
        q: "What is E20 and why compare it to Petrol?",
        a: "E20 is petrol blended with 20% ethanol, now widely rolled out at Indian pumps. It's usually priced a little below pure petrol but can give slightly lower mileage in some vehicles — the comparison tool lets you see the real ₹ difference for your own car, not a generic claim.",
      },
      ...shared,
    ];
  }

  return [
    {
      q: `Where do ${country.name} fuel prices come from?`,
      a: `We don't run a live price feed for ${country.name} yet — the price field starts pre-filled with an indicative national-average estimate, which you should always double-check and overwrite with your local pump price for an accurate result.`,
    },
    {
      q: `Are the ${country.name} vehicle mileage figures verified?`,
      a: `Not yet — unlike our India lineup (sourced from ARAI test-cycle data), the ${country.name} vehicle list is a representative estimate we've put together to cover common models. Treat every figure as a starting point, not a spec-sheet guarantee, and edit it if you know your vehicle's real mileage.`,
    },
    ...shared,
  ];
}

const faqs = faqsFor(country);
---

<Layout
  title={`FAQ | Fuel Calculate${country.code === "IN" ? "" : ` ${country.name}`}`}
  description="Answers to common questions about how Fuel Calculate sources prices, mileage, and EV running costs."
>
  <Breadcrumbs items={[{ name: "Home", href: `${country.pathPrefix}/` }, { name: "FAQ", href: `${country.pathPrefix}/faq` }]} />
  <Hero eyebrow="FAQ" title="Common questions." />
  <section class="mx-auto max-w-[720px] px-md pb-5xl sm:px-lg">
    <div class="flex flex-col gap-lg">
      {
        faqs.map((item) => (
          <div class="rounded-lg bg-canvas p-lg shadow-level-2">
            <h2 class="text-display-sm text-ink">{item.q}</h2>
            <p class="mt-sm text-body-md text-body">{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
