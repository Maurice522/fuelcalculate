---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getCountry, type CountryConfig } from "../lib/countries";
import fuelTypesIn from "../data/fuel-types/in.json";
import fuelTypesUs from "../data/fuel-types/us.json";
import fuelTypesGb from "../data/fuel-types/gb.json";
import fuelTypesCa from "../data/fuel-types/ca.json";
import fuelTypesAu from "../data/fuel-types/au.json";
import type { CountryCode } from "../lib/countries";

export const prerender = true;

interface Props {
  country?: CountryConfig;
}

const { country = getCountry("IN") } = Astro.props;

const fuelTypesByCountry: Record<CountryCode, { id: string; label: string }[]> = {
  IN: fuelTypesIn,
  US: fuelTypesUs,
  GB: fuelTypesGb,
  CA: fuelTypesCa,
  AU: fuelTypesAu,
};
const iceFuelNames = fuelTypesByCountry[country.code]
  .filter((f) => f.id !== "ev")
  .map((f) => f.label);
const symbol = country.currency.symbol;
const distanceUnit = country.distanceUnit;

const dataSourcesByCountry: Record<CountryCode, string> = {
  IN: "City fuel prices are refreshed automatically from public sources several times a day. Vehicle mileage figures are ARAI-claimed (official test-cycle) data.",
  US: "Default example prices are sourced from AAA's daily state gas price averages, state gas tax figures from the Tax Foundation, and electricity rates from EIA-based state data. Vehicle mileage figures use EPA-style ratings.",
  GB: "Default example prices are the UK government's weekly average pump price (DESNZ weekly road fuel prices), and electricity rates from Ofgem's published price cap. The vehicle list for this market is a set of representative estimates for common models, not manufacturer data — pick your car for a quick start, then enter your own car's documented mileage for accuracy.",
  CA: "Default example prices are Natural Resources Canada's daily average retail prices for regular gasoline, and electricity rates from published provincial utility rates. The vehicle list for this market is a set of representative estimates for common models, not manufacturer data — pick your car for a quick start, then enter your own car's documented mileage for accuracy.",
  AU: "Default example prices are the Australian Institute of Petroleum's weekly average retail unleaded prices by city, and electricity rates from published state utility/regulator data. The vehicle list for this market is a set of representative estimates for common models, not manufacturer data — pick your car for a quick start, then enter your own car's documented mileage for accuracy.",
};
const lastUpdated = "November 10, 2026";
---

<Layout
  title={`How the math works | Fuel Calculate${country.code === "IN" ? "" : ` ${country.name}`}`}
  description="The exact formulas Fuel Calculate uses for trip cost, fuel comparison, and monthly/yearly projections."
>
  <Breadcrumbs
    items={[
      { name: "Home", href: `${country.pathPrefix}/` },
      { name: "How it works", href: `${country.pathPrefix}/how-it-works` },
    ]}
  />
  <Hero eyebrow="Transparent by default" title="How the math works." />

  <section class="mx-auto flex max-w-[720px] flex-col gap-2xl px-md pb-5xl sm:px-lg">
    <div>
      <h2 class="text-display-sm text-ink">Cost per {distanceUnit}</h2>
      <p class="mt-sm text-body-md text-body">
        For {iceFuelNames.join(", ")}, cost per {distanceUnit} is just price divided by
        mileage:
      </p>
      <pre class="mt-sm overflow-x-auto rounded-md bg-ink p-md text-code text-on-primary">costPerUnit = pricePerUnit / mileage</pre>
      <p class="mt-sm text-body-md text-body">
        For EV, mileage is expressed as efficiency (kWh per 100{distanceUnit}) rather than
        {distanceUnit}-per-unit, since that's the standard way EV efficiency is measured —
        this avoids an inverted-unit mistake:
      </p>
      <pre class="mt-sm overflow-x-auto rounded-md bg-ink p-md text-code text-on-primary">costPerUnit = (tariffPerKwh * efficiencyKwhPer100{distanceUnit === "mi" ? "Mi" : "Km"}) / 100</pre>
    </div>

    <div>
      <h2 class="text-display-sm text-ink">Trip cost</h2>
      <p class="mt-sm text-body-md text-body">
        Round trip doubles the one-way distance before the cost is applied:
      </p>
      <pre class="mt-sm overflow-x-auto rounded-md bg-ink p-md text-code text-on-primary">effectiveDistance = roundTrip ? distanceOneWay * 2 : distanceOneWay
tripCost = costPerUnit * effectiveDistance</pre>
    </div>

    <div>
      <h2 class="text-display-sm text-ink">Comparing fuels</h2>
      <p class="mt-sm text-body-md text-body">
        Every fuel you select is costed for the same trip distance. One fuel is the
        baseline (defaults to {iceFuelNames[0] ?? "Petrol"}); every other fuel shows its {symbol} and % difference
        against it — negative means cheaper:
      </p>
      <pre class="mt-sm overflow-x-auto rounded-md bg-ink p-md text-code text-on-primary">deltaVsBaseline = cost[fuel] - cost[baseline]
percentDiff = (deltaVsBaseline / cost[baseline]) * 100</pre>
    </div>

    <div>
      <h2 class="text-display-sm text-ink">Monthly &amp; yearly projection</h2>
      <p class="mt-sm text-body-md text-body">
        Built from your daily commute pattern, not a guess at "working days" — you set
        days-per-month explicitly:
      </p>
      <pre class="mt-sm overflow-x-auto rounded-md bg-ink p-md text-code text-on-primary">dailyDistance = distancePerTrip * tripsPerDay * (roundTrip ? 2 : 1)
dailyCost = costPerUnit * dailyDistance
monthlyCost = dailyCost * daysPerMonth
yearlyCost = monthlyCost * 12</pre>
      <p class="mt-sm text-body-md text-body">
        Yearly is derived from the monthly figure (×12), not a separate ×365 daily
        calculation — so the two numbers never quietly disagree with each other.
      </p>
    </div>

    <div>
      <h2 class="text-display-sm text-ink">Where our data comes from</h2>
      <p class="mt-sm text-body-md text-body">{dataSourcesByCountry[country.code]}</p>
      <p class="mt-sm text-caption text-mute">Data sources last checked {lastUpdated}. Always editable — enter your own price and mileage for an exact result.</p>
    </div>
  </section>
</Layout>
