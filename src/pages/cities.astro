---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import citiesData from "../data/cities.json";

export const prerender = true;

const byState = citiesData.cities.reduce<Record<string, typeof citiesData.cities>>((acc, city) => {
  (acc[city.state] ??= []).push(city);
  return acc;
}, {});
const states = Object.keys(byState).sort();

const title = "Fuel Prices by City in India | Fuel Calculate";
const description =
  "Today's petrol, diesel, CNG, E20 and LPG prices for 28 Indian cities, with a fuel calculator pre-filled for each — browse by state.";
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Cities", href: "/cities" }]} />
  <Hero
    eyebrow="Browse by city"
    title="Fuel prices by city."
    lead="Petrol, diesel, CNG, E20 and LPG prices are set city by city in India — pick yours for today's price and a calculator pre-filled with it."
  />

  <section class="mx-auto max-w-[880px] px-md pb-5xl sm:px-lg">
    <div class="flex flex-col gap-xl">
      {
        states.map((state) => (
          <div>
            <h2 class="text-body-md-strong text-ink">{state}</h2>
            <div class="mt-sm flex flex-wrap gap-sm">
              {byState[state].map((city) => (
                <a
                  href={`/city/${city.slug}`}
                  class="rounded-full border border-hairline px-sm py-xxs text-body-sm text-body hover:border-hairline-strong hover:text-ink"
                >
                  {city.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
