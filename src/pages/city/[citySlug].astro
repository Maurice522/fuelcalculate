---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import CityPriceTable from "../../components/CityPriceTable.astro";
import FuelCalculatorForm from "../../components/FuelCalculatorForm.astro";
import SiteDataScript from "../../components/SiteDataScript.astro";
import FindStationsLink from "../../components/FindStationsLink.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { resolveCityPrices, findCity } from "../../lib/prices";
import { env } from "cloudflare:workers";

export const prerender = false;

const { citySlug } = Astro.params;
const city = citySlug ? findCity(citySlug) : null;

if (!city) {
  Astro.response.status = 404;
}

const resolved = city ? await resolveCityPrices(env, city.slug) : null;

// Real, computed-live price gaps for this city — not a templated claim, since it's
// derived from resolved.prices at request time and will differ city to city (and
// update whenever prices do). Only rendered when both sides of a gap actually exist.
function pctCheaper(petrol: number | null, other: number | null): number | null {
  if (petrol == null || other == null || petrol <= 0) return null;
  return Math.round(((petrol - other) / petrol) * 100);
}

const priceGaps = resolved
  ? {
      diesel: pctCheaper(resolved.prices.petrol, resolved.prices.diesel),
      cng: pctCheaper(resolved.prices.petrol, resolved.prices.cng),
      lpg: pctCheaper(resolved.prices.petrol, resolved.prices.lpg),
    }
  : null;
---

<Layout
  title={city ? `Fuel Calculator for ${city.name} — Petrol, Diesel, CNG, E20 Prices | Fuel Calculate` : "City not found | Fuel Calculate"}
  description={city ? `Today's petrol, diesel, CNG and E20 price in ${city.name}, plus a free fuel calculator pre-filled with ${city.name}'s prices for your trip cost.` : undefined}
>
  <SiteDataScript />
  {
    !city || !resolved ? (
      <section class="mx-auto max-w-[640px] px-md py-5xl text-center sm:px-lg">
        <h1 class="text-display-lg">City not found.</h1>
        <p class="mt-md text-body-lg text-body">
          We don't have a seeded price entry for that city yet. Try the calculator with a custom price instead.
        </p>
        <a href="/" class="mt-lg inline-flex h-12 items-center rounded-sm bg-ink px-lg text-button-lg text-on-primary">
          Go to the calculator
        </a>
      </section>
    ) : (
      <Fragment>
        <Breadcrumbs
          items={[
            { name: "Home", href: "/" },
            { name: "Cities", href: "/cities" },
            { name: city.name, href: `/city/${city.slug}` },
          ]}
        />
        <Hero
          eyebrow={city.state}
          title={`Fuel prices in ${city.name}`}
          lead="Updated automatically from public sources several times a day. Always confirm at the pump before you fill up."
        />
        <section class="mx-auto max-w-[720px] px-md pb-2xl sm:px-lg">
          <CityPriceTable
            cityName={city.name}
            prices={resolved.prices}
            source={resolved.source}
            lastUpdated={resolved.lastUpdated}
          />
        </section>
        <section class="border-t border-hairline bg-canvas-soft px-md py-4xl sm:px-lg">
          <div class="mx-auto max-w-[720px]">
            <h2 class="text-center text-display-md">Calculate your trip cost in {city.name}</h2>
            <div class="mt-lg">
              <FuelCalculatorForm
                initial={{
                  fuel: "petrol",
                  city: city.slug,
                  distance: "20",
                  roundtrip: "",
                  price: "",
                  mileage: "",
                  vehicle: "",
                }}
                example={
                  resolved!.prices.petrol != null
                    ? {
                        price: resolved!.prices.petrol,
                        mileage: 25.75,
                        distance: 20,
                        sourceLabel: `${resolved!.source === "crawler" ? "auto-updated" : resolved!.source} price for ${city.name} — Maruti Swift`,
                      }
                    : undefined
                }
              />
            </div>
          </div>
        </section>
        <section class="border-t border-hairline px-md py-4xl sm:px-lg">
          <div class="mx-auto max-w-[720px]">
            <FindStationsLink cityName={city.name} />
          </div>
        </section>

        <section class="border-t border-hairline bg-canvas-soft px-md py-4xl sm:px-lg">
          <div class="mx-auto flex max-w-[720px] flex-col gap-md">
            <p class="text-body-md text-body">
              Fuel prices in India are set city by city, largely because state VAT rates
              differ — so {city.name}'s petrol, diesel{
                resolved!.prices.cng != null ? ", CNG" : ""
              } and E20 prices won't match a neighbouring state's, even on the same day.
              That's why this page tracks {city.name} specifically rather than showing a
              single national average.
            </p>
            {
              (priceGaps!.diesel != null || priceGaps!.cng != null || priceGaps!.lpg != null) && (
                <p class="text-body-md text-body">
                  Right now in {city.name}
                  {priceGaps!.diesel != null && (
                    <>, diesel is about {Math.abs(priceGaps!.diesel)}% {priceGaps!.diesel > 0 ? "cheaper" : "more expensive"} than petrol per litre</>
                  )}
                  {priceGaps!.cng != null && (
                    <>, CNG is about {Math.abs(priceGaps!.cng)}% {priceGaps!.cng > 0 ? "cheaper" : "more expensive"} than petrol per unit</>
                  )}
                  {priceGaps!.lpg != null && (
                    <>, and LPG is about {Math.abs(priceGaps!.lpg)}% {priceGaps!.lpg > 0 ? "cheaper" : "more expensive"} than petrol per litre</>
                  )}
                  . That gap changes as prices move, so the calculator above always uses
                  today's {city.name} price rather than a fixed figure — enter your own
                  vehicle's mileage for the most accurate trip cost.
                </p>
              )
            }
          </div>
        </section>
      </Fragment>
    )
  }
</Layout>
