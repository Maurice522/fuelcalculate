---
import CostPerDistancePage from "../../components/CostPerDistancePage.astro";
import { SUPPORTED_COUNTRIES } from "../../lib/countries";

export const prerender = true;

// Kilometre-based markets only (Canada, Australia); India serves this at the root.
export function getStaticPaths() {
  return SUPPORTED_COUNTRIES.filter((c) => c.code === "CA" || c.code === "AU").map((c) => ({
    params: { country: c.pathPrefix.slice(1) },
  }));
}

const country = SUPPORTED_COUNTRIES.filter((c) => c.code === "CA" || c.code === "AU").find((c) => c.pathPrefix === `/${Astro.params.country}`)!;
---

<CostPerDistancePage country={country} />
