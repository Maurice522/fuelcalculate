---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import FuelCalculatorForm from "../../components/FuelCalculatorForm.astro";
import MonthlyProjection from "../../components/MonthlyProjection.astro";
import SiteDataScript from "../../components/SiteDataScript.astro";
import FindStationsLink from "../../components/FindStationsLink.astro";
import { SUPPORTED_COUNTRIES, type CountryCode } from "../../lib/countries";
import { FAQS_BY_COUNTRY } from "../../data/faqs";
import { NATIONAL_EXAMPLE_BY_COUNTRY } from "../../data/realLocalData";
import { REPRESENTATIVE_VEHICLES } from "../../data/representativeVehicles";
import { COUNTRY_DIFFERENTIATION } from "../../data/countryDifferentiation";

import fuelTypesUs from "../../data/fuel-types/us.json";
import fuelTypesGb from "../../data/fuel-types/gb.json";
import fuelTypesCa from "../../data/fuel-types/ca.json";
import fuelTypesAu from "../../data/fuel-types/au.json";

export const prerender = true;

// India stays at the existing unprefixed "/" — this tree only covers the 4 countries
// with no live per-city price data, so every page here can be fully static.
const OTHER_COUNTRIES = SUPPORTED_COUNTRIES.filter((c) => c.code !== "IN");

export function getStaticPaths() {
  return SUPPORTED_COUNTRIES.filter((c) => c.code !== "IN").map((c) => ({
    params: { country: c.pathPrefix.slice(1) },
  }));
}

const fuelTypesByCountry: Record<Exclude<CountryCode, "IN">, { id: string; label: string }[]> = {
  US: fuelTypesUs,
  GB: fuelTypesGb,
  CA: fuelTypesCa,
  AU: fuelTypesAu,
};

const country = OTHER_COUNTRIES.find((c) => c.pathPrefix === `/${Astro.params.country}`)!;
const fuelTypes = fuelTypesByCountry[country.code as Exclude<CountryCode, "IN">];

const params = Astro.url.searchParams;
const initial = {
  fuel: params.get("fuel") ?? fuelTypes[0]?.id ?? "petrol",
  city: "",
  price: params.get("price") ?? "",
  vehicle: params.get("vehicle") ?? "",
  mileage: params.get("mileage") ?? "",
  distance: params.get("distance") ?? "20",
  roundtrip: params.get("roundtrip") ?? "",
};

const fuelNamesForEyebrow = fuelTypes.map((f) => f.label).join(" · ");

// FuelCalculatorForm itself only applies this when the visitor hasn't already set a
// real price/mileage (e.g. from a shared link) — safe to always pass it here.
const nationalExample = NATIONAL_EXAMPLE_BY_COUNTRY[country.code];
const petrolVehicle = REPRESENTATIVE_VEHICLES[country.code as Exclude<CountryCode, "IN">].find(
  (v) => v.fuelType === "petrol",
)!;
const example = nationalExample
  ? { price: nationalExample.price, mileage: petrolVehicle.mileage, distance: 20, sourceLabel: nationalExample.sourceLabel }
  : undefined;

const differentiationSections = COUNTRY_DIFFERENTIATION[country.code] ?? [];

const faqs = FAQS_BY_COUNTRY[country.code];
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={`Fuel Calculator — ${country.name} Trip Cost Calculator | Fuel Calculate`}
  description={`Free fuel calculator for ${country.name}: work out trip and monthly fuel cost for your car or bike (${fuelNamesForEyebrow}), and compare fuel prices to see how much you'd save.`}
  structuredData={faqStructuredData}
>
  <SiteDataScript countryCode={country.code} />

  <Hero
    eyebrow={fuelNamesForEyebrow}
    title={`Fuel calculator — know exactly what your trip costs in ${country.name}.`}
    lead="Type your own price, choose your car or bike, and watch your trip cost update instantly — then compare it against every other fuel."
  />

  <section class="mx-auto max-w-[720px] px-md pb-4xl sm:px-lg">
    <FuelCalculatorForm initial={initial} country={country} fuelTypes={fuelTypes} example={example} />
  </section>

  <section class="border-t border-hairline bg-canvas-soft px-md py-4xl sm:px-lg">
    <div class="mx-auto max-w-[880px] text-center">
      <h2 class="text-display-lg">Compare fuels side by side.</h2>
      <p class="mx-auto mt-md max-w-[560px] text-body-lg text-body">
        See running costs for the same trip, with the exact {country.currency.symbol} and
        % difference against your baseline.
      </p>
      <a
        href={`${country.pathPrefix}/compare`}
        class="mt-lg inline-flex h-12 items-center rounded-sm bg-ink px-lg text-button-lg text-on-primary"
      >
        Open the comparison tool
      </a>
    </div>
  </section>

  <section id="monthly-budget" class="scroll-mt-16 px-md py-4xl sm:px-lg">
    <div class="mx-auto max-w-[880px] text-center">
      <h2 class="text-display-lg">Plan your monthly fuel budget.</h2>
      <p class="mx-auto mt-md max-w-[560px] text-body-lg text-body">
        Enter your daily commute and get a straight answer: what it costs you every
        month and every year.
      </p>
    </div>
    <div class="mx-auto mt-xl max-w-[720px]">
      <MonthlyProjection country={country} fuelTypes={fuelTypes} />
    </div>
  </section>

  <section class="border-t border-hairline px-md py-4xl sm:px-lg">
    <div class="mx-auto max-w-[720px]">
      <FindStationsLink countryName={country.name} />
    </div>
  </section>

  <section class="border-t border-hairline px-md py-lg sm:px-lg">
    <p class="mx-auto max-w-[720px] text-center text-body-sm text-body">
      Looking for a specific city? <a href={`${country.pathPrefix}/cities`} class="text-link underline">Browse by city in {country.name}</a>.
    </p>
  </section>

  <section class="border-t border-hairline bg-canvas-soft px-md py-4xl sm:px-lg">
    <div class="mx-auto max-w-[720px]">
      <p class="text-body-md text-body">
        This is a fuel calculator for car owners and a fuel calculator for bike
        riders in {country.name} alike{
          country.code === "US" ? ", including a diesel fuel calculator for pickups and a truck fuel calculator use case for anything larger — just enter your own mileage if your exact model isn't listed" : ""
        }. Pick your fuel type, enter your distance in {country.distanceUnit === "mi" ? "miles" : "km"}, and get
        a trip fuel cost worked out to the {country.currency.code === "USD" ? "cent" : "smallest unit"}, not a rounded-off estimate.
      </p>
    </div>
  </section>

  {
    differentiationSections.length > 0 && (
      <section class="border-t border-hairline px-md py-4xl sm:px-lg">
        <div class="mx-auto flex max-w-[720px] flex-col gap-2xl">
          {differentiationSections.map((s) => (
            <div>
              <h2 class="text-display-sm text-ink">{s.heading}</h2>
              <p class="mt-sm text-body-md text-body">{s.body}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="border-t border-hairline px-md py-4xl sm:px-lg">
    <div class="mx-auto max-w-[960px]">
      <h2 class="text-center text-display-lg">Fuel calculator FAQs.</h2>
      <p class="mx-auto mt-md max-w-[640px] text-center text-body-lg text-body">
        Straight answers to the fuel cost, comparison and monthly budget questions
        people ask most in {country.name}.
      </p>
      <div class="mt-xl flex flex-col gap-sm">
        {
          faqs.map((item, i) => (
            <details class="group rounded-lg bg-canvas p-lg shadow-level-2" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-md text-body-md-strong text-ink [&::-webkit-details-marker]:hidden">
                {item.q}
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0 text-mute transition-transform duration-200 group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <p class="mt-sm hidden text-body-sm text-body group-open:block">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
