{/*
  Binary light/dark toggle, persisted to localStorage as "fuelcalculate:theme". Starts
  from whatever the OS/browser's prefers-color-scheme currently resolves to (still
  respected in CSS for anyone who never touches this button), then always flips to an
  explicit choice on click. The no-flash "apply before paint" logic lives in
  Layout.astro's inline head script; this component only needs to reflect/change that
  same stored value.
*/}
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class="inline-flex h-8 w-8 items-center justify-center rounded-full text-body hover:bg-canvas-soft-2 hover:text-ink"
>
  <svg data-theme-icon-light viewBox="0 0 24 24" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
  </svg>
  <svg data-theme-icon-dark viewBox="0 0 24 24" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  import "../scripts/theme-toggle.ts";
</script>
