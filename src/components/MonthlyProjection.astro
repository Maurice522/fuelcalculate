---
import citiesData from "../data/cities.json";
import fuelTypesData from "../data/fuel-types.json";

// Note: the parent page must include <SiteDataScript /> once.
---

<monthly-projection class="block">
  <form class="grid gap-md rounded-lg bg-canvas p-lg shadow-level-3 sm:grid-cols-2 sm:p-xl">
    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">Fuel type</span>
      <searchable-select>
        <select data-field="fuel">
          {fuelTypesData.map((f) => <option value={f.id}>{f.label}</option>)}
        </select>
      </searchable-select>
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">City (auto-fills price)</span>
      <searchable-select>
        <select data-field="city">
          <option value="">Custom price</option>
          {citiesData.cities.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </searchable-select>
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">
        Price (<span data-out="price-unit-label">₹ per litre</span>)
      </span>
      <input
        type="number"
        step="0.01"
        min="0"
        data-field="price"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">
        Vehicle <span class="font-normal text-mute">(optional)</span>
      </span>
      <searchable-select>
        <select data-field="vehicle">
          <option value="">Manual entry</option>
        </select>
      </searchable-select>
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">
        Mileage (<span data-out="mileage-unit-label">km/l</span>)
      </span>
      <input
        type="number"
        step="0.01"
        min="0"
        data-field="mileage"
        placeholder="Enter your own or pick a vehicle"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
      <span class="text-caption text-mute" data-out="mileage-note"></span>
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">Distance per trip (km)</span>
      <input
        type="number"
        min="0"
        value="15"
        data-field="distance-per-trip"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">Trips per day</span>
      <input
        type="number"
        min="0"
        value="2"
        data-field="trips-per-day"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
    </label>

    <label class="flex flex-col gap-xxs">
      <span class="text-body-sm-strong text-ink">Days per month</span>
      <input
        type="number"
        min="1"
        max="31"
        value="30"
        data-field="days-per-month"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
    </label>

    <label class="flex items-center gap-xs sm:col-span-2">
      <input type="checkbox" data-field="roundtrip" class="h-4 w-4 rounded-xs border border-hairline" />
      <span class="text-body-sm text-ink">Each trip is a round trip</span>
    </label>
  </form>

  <div class="mt-lg grid gap-md sm:grid-cols-3">
    <div class="rounded-lg bg-canvas-soft p-lg shadow-level-1">
      <p class="text-caption-mono uppercase text-mute">Per day</p>
      <p class="mt-xxs text-display-sm text-ink" data-out="daily-cost">₹0</p>
      <p class="text-body-sm text-body" data-out="daily-distance">0 km</p>
    </div>
    <div class="rounded-lg bg-canvas-soft p-lg shadow-level-1">
      <p class="text-caption-mono uppercase text-mute">Per month</p>
      <p class="mt-xxs text-display-sm text-ink" data-out="monthly-cost">₹0</p>
      <p class="text-body-sm text-body" data-out="monthly-distance">0 km</p>
    </div>
    <div class="rounded-lg bg-ink p-lg shadow-level-2">
      <p class="text-caption-mono uppercase text-on-primary/70">Per year</p>
      <p class="mt-xxs text-display-sm text-on-primary" data-out="yearly-cost">₹0</p>
    </div>
  </div>
</monthly-projection>

<script>
  import "../scripts/monthly-projection.ts";
</script>
