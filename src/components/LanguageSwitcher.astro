---
// English-only content for now — this is real UI (not a stub), but selecting anything
// other than English is a no-op until translations actually exist. Kept separate from
// CountrySwitcher since language and country are independent choices (e.g. a Spanish
// speaker in the US), even though only one language is live today.
const languages = [
  { code: "en", label: "English", available: true },
  { code: "hi", label: "हिन्दी (coming soon)", available: false },
  { code: "es", label: "Español (coming soon)", available: false },
];
---

<select
  data-language-switcher
  aria-label="Language"
  class="h-6 cursor-pointer appearance-none rounded-full border border-hairline bg-canvas py-0 pl-xs pr-md text-caption text-ink"
>
  {
    languages.map((lang) => (
      <option value={lang.code} disabled={!lang.available} selected={lang.code === "en"}>
        {lang.label}
      </option>
    ))
  }
</select>
