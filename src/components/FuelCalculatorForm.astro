---
import citiesData from "../data/cities.json";
import fuelTypesIn from "../data/fuel-types/in.json";
import { getCountry, type CountryConfig } from "../lib/countries";

// Note: the parent page must include <SiteDataScript /> once — this widget reads
// from the shared #site-data JSON island rather than embedding its own copy.

interface FuelTypeOption {
  id: string;
  label: string;
}

interface Props {
  initial?: Partial<{
    city: string;
    fuel: string;
    distance: string;
    roundtrip: string;
    price: string;
    mileage: string;
    vehicle: string;
  }>;
  /** Defaults to India — the only country with live per-city prices/a city picker. */
  country?: CountryConfig;
  fuelTypes?: FuelTypeOption[];
}

const {
  initial = {
    fuel: "petrol",
    distance: "20",
    roundtrip: "",
    city: "",
    price: "",
    mileage: "",
  },
  country = getCountry("IN"),
  fuelTypes = fuelTypesIn,
} = Astro.props;

const cities = country.code === "IN" ? citiesData.cities : [];
const volumeLabel = country.volumeUnit === "gallon" ? "gallon" : "litre";
const mileageUnitLabel = `${country.distanceUnit}/${country.volumeUnit === "gallon" ? "gal" : "l"}`;
const symbol = country.currency.symbol;
---

<fuel-calculator class="block">
  <form method="get" class="grid gap-md rounded-lg bg-canvas p-lg shadow-level-3 sm:grid-cols-2 sm:p-xl">
    <label class="flex flex-col gap-xxs sm:col-span-1">
      <span class="text-body-sm-strong text-ink">Fuel type</span>
      <searchable-select>
        <select name="fuel" data-field="fuel">
          {
            fuelTypes.map((f) => (
              <option value={f.id} selected={initial.fuel === f.id}>
                {f.label}
              </option>
            ))
          }
        </select>
      </searchable-select>
    </label>

    {
      cities.length > 0 && (
        <label class="flex flex-col gap-xxs sm:col-span-1">
          <span class="text-body-sm-strong text-ink">City (auto-fills price)</span>
          <searchable-select>
            <select name="city" data-field="city">
              <option value="">Custom price</option>
              {cities.map((c) => (
                <option value={c.slug} selected={initial.city === c.slug}>
                  {c.name}
                </option>
              ))}
            </select>
          </searchable-select>
        </label>
      )
    }

    <label class="flex flex-col gap-xxs sm:col-span-1">
      <span class="text-body-sm-strong text-ink">
        Price (<span data-out="price-unit-label">{symbol} per {volumeLabel}</span>)
      </span>
      <input
        type="number"
        step="0.01"
        min="0"
        name="price"
        data-field="price"
        value={initial.price}
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
      <span class="text-caption text-mute" data-out="price-source">Custom price</span>
    </label>

    <label class="flex flex-col gap-xxs sm:col-span-1">
      <span class="text-body-sm-strong text-ink">
        Vehicle <span class="font-normal text-mute">(optional — pick one to auto-fill mileage)</span>
      </span>
      <searchable-select>
        <select name="vehicle" data-field="vehicle">
          <option value="">Manual entry</option>
        </select>
      </searchable-select>
    </label>

    <label class="flex flex-col gap-xxs sm:col-span-1">
      <span class="text-body-sm-strong text-ink">
        Mileage (<span data-out="mileage-unit-label">{mileageUnitLabel}</span>)
      </span>
      <input
        type="number"
        step="0.01"
        min="0"
        name="mileage"
        data-field="mileage"
        value={initial.mileage}
        placeholder="Enter your own or pick a vehicle"
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
      <span class="text-caption text-mute" data-out="mileage-note"></span>
    </label>

    <label class="flex flex-col gap-xxs sm:col-span-1">
      <span class="text-body-sm-strong text-ink">Distance — one way ({country.distanceUnit})</span>
      <input
        type="number"
        step="1"
        min="0"
        name="distance"
        data-field="distance"
        value={initial.distance}
        class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-body-sm text-ink"
      />
    </label>

    <label class="flex items-center gap-xs sm:col-span-2">
      <input
        type="checkbox"
        name="roundtrip"
        data-field="roundtrip"
        checked={initial.roundtrip === "true" || initial.roundtrip === "1"}
        class="checkbox-input"
      />
      <span class="text-body-sm text-ink">Round trip</span>
    </label>

    <button
      type="submit"
      class="h-12 rounded-sm bg-ink text-button-lg text-on-primary sm:col-span-2"
    >
      Calculate
    </button>
  </form>

  <div class="mt-lg rounded-lg bg-canvas-soft p-lg shadow-level-1">
    <p class="text-caption text-mute" data-out="distance-used">0 {country.distanceUnit}</p>
    <p class="mt-xxs text-display-md text-ink" data-out="cost">{symbol}0</p>
    <p class="text-body-sm text-body" data-out="cost-per-km">{symbol}0 / {country.distanceUnit}</p>
  </div>
</fuel-calculator>

<script>
  import "../scripts/fuel-calculator.ts";
</script>
