---
const columns = [
  {
    heading: "Calculator",
    links: [
      { href: "/", label: "Trip cost calculator" },
      { href: "/compare", label: "Compare fuels" },
    ],
  },
  {
    heading: "Compare",
    links: [
      { href: "/compare/petrol-vs-cng", label: "Petrol vs CNG" },
      { href: "/compare/petrol-vs-e20", label: "Petrol vs E20" },
      { href: "/compare/petrol-vs-ev", label: "Petrol vs EV" },
      { href: "/compare/petrol-vs-diesel", label: "Petrol vs Diesel" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { href: "/how-it-works", label: "How the math works" },
      { href: "/faq", label: "FAQ" },
    ],
  },
];
---

<footer class="border-t border-hairline bg-canvas px-md py-4xl sm:px-lg">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-xl md:grid-cols-4">
    {
      columns.map((col) => (
        <div>
          <p class="text-caption-mono uppercase text-mute">{col.heading}</p>
          <ul class="mt-sm flex flex-col gap-xs">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-body hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="text-caption-mono uppercase text-mute">Fuel Calculate</p>
      <p class="mt-sm text-body-sm text-body">
        City fuel prices are refreshed automatically from public sources and are
        indicative — always confirm at the pump. Vehicle mileage figures are
        ARAI-claimed averages; real-world mileage varies.
      </p>
    </div>
  </div>

  <div class="mx-auto mt-3xl max-w-[1400px] border-t border-hairline pt-lg">
    <p class="text-caption text-mute">
      © {new Date().getFullYear()} Fuel Calculate — fuelcalculate.com
    </p>
  </div>
</footer>
