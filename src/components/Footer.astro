---
import { getCountryFromPathname, type CountryCode } from "../lib/countries";
import { COMPARE_PAIRS_BY_COUNTRY } from "../data/comparePairs";

import fuelTypesIn from "../data/fuel-types/in.json";
import fuelTypesUs from "../data/fuel-types/us.json";
import fuelTypesGb from "../data/fuel-types/gb.json";
import fuelTypesCa from "../data/fuel-types/ca.json";
import fuelTypesAu from "../data/fuel-types/au.json";

const country = getCountryFromPathname(Astro.url.pathname);
const prefix = country.pathPrefix;
const pairs = COMPARE_PAIRS_BY_COUNTRY[country.code].slice(0, 4);

// Real per-country fuel labels (e.g. "Gasoline" not "Petrol" for the US, "Electric
// (EV)" not a naive-capitalised "Ev") — a plain string.charAt(0).toUpperCase() heuristic
// doesn't know EV is an abbreviation, which is how "Petrol vs Ev" got onto this footer
// even though the pages themselves already used the correct labels.
const fuelTypesByCountry: Record<CountryCode, { id: string; shortLabel: string }[]> = {
  IN: fuelTypesIn,
  US: fuelTypesUs,
  GB: fuelTypesGb,
  CA: fuelTypesCa,
  AU: fuelTypesAu,
};
const fuelTypes = fuelTypesByCountry[country.code];
const fuelLabel = (id: string) => fuelTypes.find((f) => f.id === id)?.shortLabel ?? id;

function pairLabel(fuels: [string, string]): string {
  return `${fuelLabel(fuels[0])} vs ${fuelLabel(fuels[1])}`;
}

const columns = [
  {
    heading: "Calculator",
    links: [
      { href: `${prefix}/`, label: "Trip cost calculator" },
      { href: `${prefix}/compare`, label: "Compare fuels" },
    ],
  },
  {
    heading: "Compare",
    links: pairs.map((p) => ({ href: `${prefix}/compare/${p.slug}`, label: pairLabel(p.fuels) })),
  },
  {
    heading: "Resources",
    links: [
      { href: `${prefix}/how-it-works`, label: "How the math works" },
      { href: `${prefix}/faq`, label: "FAQ" },
      { href: `${prefix}/cities`, label: "Browse by city" },
      { href: "/blog", label: "Blog" },
      { href: "/about", label: "About us" },
      { href: "/contact", label: "Contact us" },
    ],
  },
];

const disclaimer =
  country.code === "IN"
    ? "City fuel prices are refreshed automatically from public sources and are indicative — always confirm at the pump. Vehicle mileage figures are ARAI-claimed averages; real-world mileage varies."
    : `Fuel prices for ${country.name} are an indicative national average, not a live feed — always confirm at the pump. Vehicle mileage figures are representative estimates; real-world mileage varies.`;
---

<footer class="border-t border-hairline bg-canvas px-md py-4xl sm:px-lg">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-xl md:grid-cols-4">
    {
      columns.map((col) => (
        <div>
          <p class="text-caption-mono uppercase text-mute">{col.heading}</p>
          <ul class="mt-sm flex flex-col gap-xs">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-body hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="text-caption-mono uppercase text-mute">Fuel Calculate</p>
      <p class="mt-sm text-body-sm text-body">
        {disclaimer}
      </p>
    </div>
  </div>

  <div class="mx-auto mt-3xl flex max-w-[1400px] flex-wrap items-center justify-between gap-sm border-t border-hairline pt-lg">
    <p class="text-caption text-mute">
      © {new Date().getFullYear()} Fuel Calculate — fuelcalculate.com
    </p>
    <div class="flex flex-wrap items-center gap-md">
      <a href="/privacy-policy" class="text-caption text-mute hover:text-ink">Privacy Policy</a>
      <a href="/terms" class="text-caption text-mute hover:text-ink">Terms &amp; Conditions</a>
    </div>
  </div>
</footer>
